# Sajal's Supabase project. Values are in the project's Connect dialog.
# All of these stay server-only: never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# The Sajal event this deployment registers people for (events.id).
SAJAL_EVENT_ID=00000000-0000-0000-0000-000000000000

# Only the dormant /admin portal uses this. Registration does not need it.
SUPABASE_SECRET_KEY=
